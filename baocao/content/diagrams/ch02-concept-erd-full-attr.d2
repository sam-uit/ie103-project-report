loaiphong_gia_co_ban: {class: attr; label: "Giá Cơ Bản"; width: 110}
loaiphong_mo_ta: {class: attr; label: "Mô Tả"}
loaiphong_suc_chua: {class: attr; label: "Sức Chứa"}

