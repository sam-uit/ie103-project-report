                  "sqlAfter": "SELECT dp.id, dp.user_id, dp.voucher_id, ISNULL(v.ma_code, 'N/A') AS voucher_code, dp.trang_thai FROM DATPHONG dp LEFT JOIN VOUCHERS v ON v.id = dp.voucher_id WHERE dp.id = @DatPhongId",
                  "sqlFetchInitial": "SELECT TOP 10 dp.id, dp.user_id, dp.voucher_id, ISNULL(v.ma_code, 'N/A') AS voucher_code, dp.trang_thai FROM DATPHONG dp LEFT JOIN VOUCHERS v ON v.id = dp.voucher_id ORDER BY dp.created_at ASC",
